diff --git a/automouse/automouse.c b/automouse/automouse.c
index 9801d99..326dc98 100644
--- a/automouse/automouse.c
+++ b/automouse/automouse.c
@@ -25,6 +25,12 @@ static struct {
     .enabled = {[AUTOMOUSE_DEVICE_TRACKBALL] = AUTOMOUSE_ENABLED_TRACKBALL, [AUTOMOUSE_DEVICE_TRACKPAD] = AUTOMOUSE_ENABLED_TRACKPAD},
 };
 
+#ifndef AUTOMOUSE_CONTACT_STALE_MS
+#    define AUTOMOUSE_CONTACT_STALE_MS 120  // finger-contact freshness window (ms)
+#endif
+static bool     finger_present = false;
+static uint16_t last_contact   = 0;
+
 static bool automouse_default_enabled_for(automouse_device_t dev) {
     return dev == AUTOMOUSE_DEVICE_TRACKPAD ? AUTOMOUSE_ENABLED_TRACKPAD : AUTOMOUSE_ENABLED_TRACKBALL;
 }
@@ -232,8 +238,15 @@ report_mouse_t pointing_device_task_automouse(report_mouse_t mouse_report) {
         return mouse_report;
     }
 
-    // Keep layer alive while keys are held on it
-    if (state.is_active && state.held_keys > 0) {
+    // Keep the layer alive while keys are held on it, or while a finger rests in contact.
+    // The contact term is scoped to a trackpad-owned session and gated on that session's
+    // layer ACTUALLY being on (layer_state_is), so a layer the keymap typed-off is never
+    // kept warm — its normal timeout/reset runs.
+    if (state.is_active &&
+        (state.held_keys > 0 ||
+         (state.active_device == AUTOMOUSE_DEVICE_TRACKPAD &&
+          layer_state_is(state.active_layer) && finger_present &&
+          timer_elapsed(last_contact) < AUTOMOUSE_CONTACT_STALE_MS))) {
         state.last_activity = timer_read();
     }
 
@@ -276,6 +289,19 @@ void automouse_report_motion(int16_t dx, int16_t dy, uint8_t buttons) {
     automouse_accumulate(AUTOMOUSE_DEVICE_TRACKPAD, dx, dy, 0, 0, buttons);
 }
 
+// Feed finger-contact presence from the same digitizer that calls
+// automouse_report_motion(), so a motionless-but-present finger keeps the trackpad's
+// mouse layer warm while that layer owns the active session.
+void automouse_report_contact(bool present) {
+    if (!state.enabled[AUTOMOUSE_DEVICE_TRACKPAD]) {
+        return;
+    }
+    finger_present = present;
+    if (present) {
+        last_contact = timer_read();
+    }
+}
